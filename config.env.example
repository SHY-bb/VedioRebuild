# WorldRebuild 本机配置示例
# 复制为 config.env 后修改；config.env 已被 .gitignore 忽略，不会提交。

# ── 依赖前缀（Qt / OpenCV / PCL 编译安装的根目录）──
# 默认 /opt，即 /opt/qt/6.8.0、/opt/opencv/4.11.0 ...
WR_PREFIX_ROOT=/opt

# ── Python 虚拟环境（需包含 torch / gsplat / depth-anything-3 / pycolmap / open3d）──
WR_PYTHON_ENV=/opt/sam-venv

# ── 脚本与模型目录（留空则自动探测 build/ 或 install/ 布局）──
# WR_SCRIPTS_DIR=/path/to/WorldRebuild/scripts
# WR_MODELS_DIR=/path/to/WorldRebuild/models

# ── 外部工具 ──
# COLMAP_BIN=$HOME/.local/colmap-install/bin/colmap
# GLOMAP_BIN=$HOME/.local/glomap-install/bin/glomap

# ── 特定模型权重（默认 models/ 下，通常无需修改）──
# DA3_MODEL_DIR=/path/to/models/DA3-SMALL
# VGGT_DIR=$HOME/.local/vggt-src/vggt
# VGGT_CHECKPOINT=/path/to/models/VGGT-1B/model.safetensors
# VGGT_OMEGA_DIR=$HOME/.local/vggt-src/vggt-omega
# VGGT_OMEGA_CHECKPOINT=/path/to/models/VGGT-Omega/vggt_omega_1b_512.pt

# ── 附加库搜索路径（一般不用改）──
# WR_EXTRA_LIB_PATH=/opt/opencv/4.11.0/lib:/opt/qt/6.8.0/lib:/opt/pcl/1.14.1/lib
